{
  "openapi": "3.1.0",
  "info": {
    "title": "Autonomous Code Review & Refactoring Agent",
    "description": "Review changed Python files and apply only approved refactors.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/webhooks/github": {
      "post": {
        "summary": "Start Review",
        "description": "Start a review and stop at its human-approval interrupt.",
        "operationId": "start_review_api_webhooks_github_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GitHubWebhookPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/reviews/{thread_id}/approve": {
      "post": {
        "summary": "Decide Review",
        "description": "Resume an approved review or regenerate after reviewer feedback.",
        "operationId": "decide_review_api_reviews__thread_id__approve_post",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Thread Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApprovalRequest": {
        "properties": {
          "approved": {
            "type": "boolean",
            "title": "Approved"
          },
          "feedback": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feedback"
          }
        },
        "type": "object",
        "required": [
          "approved"
        ],
        "title": "ApprovalRequest",
        "description": "Approval or rejection decision for a proposed refactor."
      },
      "GitHubWebhookPayload": {
        "properties": {
          "action": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action"
          },
          "repository": {
            "$ref": "#/components/schemas/RepositoryPayload"
          },
          "pull_request": {
            "$ref": "#/components/schemas/PullRequestPayload"
          }
        },
        "type": "object",
        "required": [
          "repository",
          "pull_request"
        ],
        "title": "GitHubWebhookPayload",
        "description": "Subset of GitHub's pull_request webhook event."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PullRequestHeadPayload": {
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "title": "Ref"
          },
          "repo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RepositoryPayload"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "ref"
        ],
        "title": "PullRequestHeadPayload",
        "description": "Pull-request source branch information."
      },
      "PullRequestPayload": {
        "properties": {
          "number": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Number"
          },
          "html_url": {
            "type": "string",
            "minLength": 1,
            "title": "Html Url"
          },
          "head": {
            "$ref": "#/components/schemas/PullRequestHeadPayload"
          }
        },
        "type": "object",
        "required": [
          "number",
          "html_url",
          "head"
        ],
        "title": "PullRequestPayload",
        "description": "Pull-request fields needed to identify the review target."
      },
      "RepositoryPayload": {
        "properties": {
          "full_name": {
            "type": "string",
            "minLength": 3,
            "title": "Full Name"
          }
        },
        "type": "object",
        "required": [
          "full_name"
        ],
        "title": "RepositoryPayload",
        "description": "Repository fields used from a GitHub webhook."
      },
      "ReviewResponse": {
        "properties": {
          "thread_id": {
            "type": "string",
            "title": "Thread Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "refactored_code": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refactored Code"
          },
          "lint_errors": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lint Errors"
          }
        },
        "type": "object",
        "required": [
          "thread_id",
          "status",
          "detail"
        ],
        "title": "ReviewResponse",
        "description": "Status returned for a review thread."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
